<% var compact = typeof compact !== 'undefined' && compact; var on = state && state.saved && state.saved[type].indexOf(id) >= 0; %>
<form method="post" action="/shortlist/toggle" class="inline-toggle" data-toggle-form="shortlist">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="type" value="<%= type %>"><input type="hidden" name="id" value="<%= id %>">
  <button type="submit" class="pill-toggle heart<%= compact ? ' compact' : '' %>" aria-pressed="<%= on ? 'true' : 'false' %>" title="<%= on ? t('shortlist.remove') : t('shortlist.save') %>" data-label-on="<%= t('shortlist.remove') %>" data-label-off="<%= t('shortlist.save') %>" data-toast-on="<%= t('shortlist.added') %>" data-toast-off="<%= t('shortlist.removed') %>" data-short-on="<%= t('shortlist.short_on') %>" data-short-off="<%= t('shortlist.short_off') %>"><%- icon(on ? 'heart-filled' : 'heart') %><span data-short<%- compact ? ' class="sr-only"' : '' %>><%= on ? t('shortlist.short_on') : t('shortlist.short_off') %></span></button>
</form>
